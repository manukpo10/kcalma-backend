# Copy to .env and fill in real values. .env is gitignored -- never commit it.
# (This template is named env.example without a leading dot because some local tooling
# blocks writes to dotfiles named .env*; rename/copy it to .env for local use.)

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Dashboard -> Connect -> ORMs/JDBC -> "Session pooler" connection string (port 5432).
# Must be the SESSION pooler, not the transaction pooler (6543) -- Flyway needs a stable session.
DB_URL=jdbc:postgresql://aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-db-password

# Optional: comma-separated Supabase auth user UUIDs treated as admins. The API is open to any
# authenticated (non-anonymous) Supabase user from this project -- this list no longer gates
# access. Admins skip the global Gemini cap and their own per-user DAILY cap below, but never the
# per-user 10-minute burst cap -- that still applies to everyone, admins included.
OWNER_USER_IDS=00000000-0000-0000-0000-000000000000

# Optional: per-user Gemini limits (/api/food/analyze, /api/food/analyze-text, /api/suggestions
# combined). Lowered from a single-owner-era 150/day: with open registration, ~10 users share one
# project's free quota.
# GEMINI_USER_PER_10MIN=20
# GEMINI_USER_PER_DAY=50

# Optional: global Gemini usage cap shared by every user combined, on top of each user's own
# per-user limits above -- protects the whole app's free-tier Gemini quota (~500/day). Admins
# (OWNER_USER_IDS) skip it.
# GEMINI_GLOBAL_PER_MINUTE=10
# GEMINI_GLOBAL_PER_DAY=500

# Comma-separated list of allowed frontend origins for CORS.
ALLOWED_ORIGINS=http://localhost:5173

# Google AI Studio -> Get API key (free tier, no card required). Never commit the real key.
GEMINI_API_KEY=your-gemini-api-key

# Optional: override the default model (see https://ai.google.dev/gemini-api/docs/models).
# GEMINI_MODEL=gemini-3.5-flash-lite
